{
  "name": "rule-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "A rule-driven business configuration workbench for frontend-led full-stack practice.",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n web,bff -c blue,green \"pnpm dev:web\" \"pnpm dev:bff\"",
    "dev:web": "pnpm --filter @rule-workbench/web dev",
    "dev:bff": "pnpm --filter @rule-workbench/bff start:dev",
    "build": "pnpm -r --if-present run build",
    "build:libs": "pnpm --filter @rule-workbench/contracts build && pnpm --filter @rule-workbench/rule-engine build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test:unit": "pnpm run build:libs && pnpm -r --if-present run test:unit",
    "test:e2e": "pnpm --filter @rule-workbench/bff test:e2e",
    "prisma:generate": "pnpm --filter @rule-workbench/bff prisma:generate",
    "db:migrate:deploy": "pnpm --filter @rule-workbench/bff db:migrate:deploy",
    "db:seed": "pnpm --filter @rule-workbench/bff db:seed",
    "check:static": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "check": "pnpm check:static && pnpm build"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
