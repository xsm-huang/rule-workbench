# 当前运行环境
NODE_ENV=development
# BFF 服务端口
PORT=3000
# 允许访问 BFF 的前端来源
WEB_ORIGIN=http://localhost:5173
# PostgreSQL 连接字符串
DATABASE_URL=postgresql://rule_user:rule_password@localhost:5432/rule_workbench?schema=public
# 后续登录令牌签名密钥
JWT_SECRET=replace-with-at-least-32-random-characters
# 令牌有效期
JWT_EXPIRES_IN=2h