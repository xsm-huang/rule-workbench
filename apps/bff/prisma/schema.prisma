// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// 定义了数据模型后，生成可供 TypeScript 使用的 Prisma Client，运行 `npx prisma generate`。
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// 名为 db 的数据源使用 PostgreSQL
datasource db {
  provider = "postgresql"
}

// EDITOR-编辑， REVIEWER-审核， VIEWER-查看
enum UserRole {
  EDITOR
  REVIEWER
  VIEWER
}

// DRAFT-草稿， PENDING_REVIEW-待审核， PUBLISHED-已发布， REJECTED-已驳回
enum SchemeStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

// UNIT_PRICE-单价计价， TOTAL_POOL-总盘计价
enum PricingMode {
  UNIT_PRICE
  TOTAL_POOL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         UserRole
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  schemes      Scheme[]

  @@map("users")
}

model Scheme {
  id               String       @id @default(cuid())
  code             String       @unique
  name             String
  scope            String
  pricingMode      PricingMode  @map("pricing_mode")
  effectiveDate    DateTime     @map("effective_date")
  remark           String?
  status           SchemeStatus @default(DRAFT)
  ownerId          String       @map("owner_id")
  content          Json
  editVersion      Int          @default(1) @map("edit_version")
  currentVersionNo Int          @default(1) @map("current_version_no")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  owner            User         @relation(fields: [ownerId], references: [id])

  @@index([status, updatedAt])
  @@index([ownerId])
  @@map("schemes")
}

